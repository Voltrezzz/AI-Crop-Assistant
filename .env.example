# Browser-visible Supabase project settings. Use the publishable/anon key, never the service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Gemini is proxied by the Supabase Edge Function. Configure GEMINI_API_KEY,
# GEMINI_MODEL (for example, gemini-3.7-flash), and ALLOWED_ORIGIN with
# `supabase secrets set`; never add Gemini credentials as VITE_* variables.

# Optional Google Maps browser key. Restrict it by HTTP referrer and enabled API.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key
